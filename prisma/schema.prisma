// Prisma schema for the family recipe box.
//
// Postgres, in dev and in production, so what runs locally is what deploys.
// Models avoid provider-specific native types.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  notes       String?
  // Where it came from, as a human reads it: "Grandma", "Serious Eats".
  source      String?
  // The original link, when there was one. Kept separately from `source` so it
  // can be rendered as a link without guessing whether `source` is a URL.
  sourceUrl   String?
  servings    String?
  prepMinutes Int?
  cookMinutes Int?
  photoUrl    String?
  isFavorite  Boolean @default(false)

  // Set by the importer when the source doc was missing instructions or
  // ingredients, so the app can surface what still needs filling in.
  needsReview Boolean @default(false)

  // Denormalised lowercase haystack (title + ingredients + tags + notes).
  // Keeps search a single indexed LIKE instead of a fan-out of joins.
  searchText String @default("")

  ingredients  Ingredient[]
  steps        Step[]
  tags         RecipeTag[]
  plannedFor   MealPlanEntry[]
  groceryItems GroceryItem[]
  shareLinks   ShareLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  // Sub-section this belongs to, e.g. "Dressing", "Topping". Null = main list.
  group    String?
  text     String
  position Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Step {
  id       String  @id @default(cuid())
  recipeId String
  group    String?
  text     String
  position Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  // course | cuisine | diet | occasion | general — drives grouping in the filter UI
  kind String @default("general")

  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}

model MealPlanEntry {
  id   String   @id @default(cuid())
  // Midnight UTC of the planned day; the app treats this as a plain date.
  date DateTime
  slot String   @default("dinner") // breakfast | lunch | dinner | other

  recipeId String?
  // Free-text entries like "leftovers" or "eat out" that aren't recipes.
  noteText String?
  position Int     @default(0)

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
}

model GroceryItem {
  id      String  @id @default(cuid())
  text    String
  checked Boolean @default(false)

  // Provenance: which recipe put this on the list. Kept as a snapshot label too,
  // so the line still reads sensibly if the recipe is later deleted.
  recipeId    String?
  sourceLabel String?
  manual      Boolean @default(false)

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([checked])
}

/// A read-only public link to one recipe, for sending to someone who doesn't
/// have the household password. The token is the secret: unguessable, and the
/// only thing that grants access. Revoking sets `revokedAt` rather than
/// deleting the row, so a link that stops working can still be explained.
model ShareLink {
  id       String @id @default(cuid())
  token    String @unique
  recipeId String

  // Set when the link is turned off. A revoked link 404s like a missing one.
  revokedAt DateTime?

  // Light usage signal so you can see whether a link was ever opened.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipeId])
}
