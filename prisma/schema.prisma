// Prisma schema for the family recipe box.
//
// SQLite for local dev. Every model deliberately avoids Postgres/MySQL-only
// native types, so moving to Postgres for deployment is a one-line change to
// `provider` below plus a fresh migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Recipe {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  notes       String?
  // Where it came from: "Grandma", an URL, "Instagram", etc.
  source      String?
  servings    String?
  prepMinutes Int?
  cookMinutes Int?
  photoUrl    String?
  isFavorite  Boolean @default(false)

  // Set by the importer when the source doc was missing instructions or
  // ingredients, so the app can surface what still needs filling in.
  needsReview Boolean @default(false)

  // Denormalised lowercase haystack (title + ingredients + tags + notes).
  // Keeps search a single indexed LIKE instead of a fan-out of joins.
  searchText String @default("")

  ingredients  Ingredient[]
  steps        Step[]
  tags         RecipeTag[]
  plannedFor   MealPlanEntry[]
  groceryItems GroceryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  // Sub-section this belongs to, e.g. "Dressing", "Topping". Null = main list.
  group    String?
  text     String
  position Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Step {
  id       String  @id @default(cuid())
  recipeId String
  group    String?
  text     String
  position Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  // course | cuisine | diet | occasion | general — drives grouping in the filter UI
  kind String @default("general")

  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}

model MealPlanEntry {
  id   String   @id @default(cuid())
  // Midnight UTC of the planned day; the app treats this as a plain date.
  date DateTime
  slot String   @default("dinner") // breakfast | lunch | dinner | other

  recipeId String?
  // Free-text entries like "leftovers" or "eat out" that aren't recipes.
  noteText String?
  position Int     @default(0)

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
}

model GroceryItem {
  id      String  @id @default(cuid())
  text    String
  checked Boolean @default(false)

  // Provenance: which recipe put this on the list. Kept as a snapshot label too,
  // so the line still reads sensibly if the recipe is later deleted.
  recipeId    String?
  sourceLabel String?
  manual      Boolean @default(false)

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([checked])
}
